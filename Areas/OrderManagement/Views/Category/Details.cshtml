@model Category

@{
    ViewBag.Title = "Category Details";
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>

<div class="card">
    <div class="card-body">
        <h4>Categories</h4>
        <hr/>
        
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.CategoryName)
            </dt>
            <dt class="col-sm-2">
                @Html.DisplayFor(model => model.CategoryName)
            </dt>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.CategoryDescription)
            </dt>
            <dt class="col-sm-2">
                @Html.DisplayFor(model => model.CategoryDescription)
            </dt>
        </dl>
        
        <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</div>

