@model List<Order>

@{
    ViewBag.Title = "Order List";
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>

<a asp-action="Create" class="btn btn-primary">Create New Order</a>

@if (Model.Any())
{
    <table class="table">
        <thead>
        <tr>
            <th>Order Date</th>
            <th>Customer Name</th>
            <th>Customer Email</th>
            <th>Products</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderDate</td>
                <td>@order.GuestName</td>
                <td>@order.GuestEmail</td>
                <td>
                    <ul>
                        @foreach (var orderProduct in order.OrderProducts)
                        {
                            <li>@orderProduct.Products.ProductName (Quantity: @orderProduct.Quantity)</li>
                        }
                    </ul>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@order.OrderId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No orders available.</p>
}