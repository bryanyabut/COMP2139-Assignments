@model Order

@{
    ViewBag.Title = "Order Details";
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>

<div>
    <h4>Order</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Order Date
        </dt>
        <dd class="col-sm-10">
            @Model.OrderDate
        </dd>
        <dt class="col-sm-2">
            Total Price
        </dt>
        <dd class="col-sm-10">
            @Model.TotalPrice
        </dd>
    </dl>
</div>

<h4>Order Products</h4>
<table class="table">
    <thead>
    <tr>
        <th>Product Name</th>
        <th>Quantity</th>
        <th>Price</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var orderProduct in Model.OrderProducts)
    {
        <tr>
            <td>@orderProduct.Products.ProductName</td>
            <td>@orderProduct.Quantity</td>
            <td>@orderProduct.Products.ProductPrice</td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-primary">Back to List</a>