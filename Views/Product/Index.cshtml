@model List<Product>

@{
    ViewData["Title"] = "Inventory List";
    Layout = "_Layout";
}

<h2>@ViewData["Title"]</h2>

<a asp-action="Create" class="btn btn-primary">Create New Product</a>

@if (ViewBag.LowStockProducts != null && ViewBag.LowStockProducts.Count > 0)
{
    <div class="alert alert-danger">
        <strong>Alert! Low in Stock</strong> Products below the low stock threshold:
        <ul>
            @foreach (var product in ViewBag.LowStockProducts)
            {
                <li>@product.ProductName (Quantity: @product.ProductQuantity)</li>
            }
        </ul>
    </div>
}

<form asp-action="Index" method="get">
    <h1>Search: </h1>
    <div class="form-group">
        <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control-sm" placeholder="Search by name"/>
    </div>
    <div class="form-group">
        <input type="number" name="minPrice" class="form-control-sm" placeholder="Minimum Price" step="0.01"/>
    </div>
    <div class="form-group">
        <input type="number" name="maxPrice" class="form-control-sm" placeholder="Maximum Price" step="0.01"/>
    </div>
    <div class="form-group">
        <select name="sortOrder" class="form-control">
            <option value="">Sort by</option>
            <option value="name_desc">Name Descending</option>
            <option value="price_asc">Price Ascending</option>
            <option value="price_desc">Price Descending</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-action="Index" class="btn btn-secondary">Reset</a>
</form>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Low Stock Threshold</th>
                <th>Category</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductName</td>
                    <td>@product.ProductDescription</td>
                    <td>@product.ProductPrice</td>
                    <td>@product.ProductQuantity</td>
                    <td>@product.LowStockThreshold</td>
                    <td>@product.Categories.CategoryName</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No products available.</p>
}
