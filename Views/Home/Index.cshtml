@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section text-center bg-primary text-white py-5">
    <h1 class="display-4 fw-bold">Welcome to DIGITS Inc</h1>
    <p class="lead">Your trusted solution for Inventory Management</p>
    <a href="/OrderManagement/Order/Index" class="btn btn-light btn-lg mt-3">Get Started</a>
</div>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="fa-solid fa-box fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Manage Inventory</h5>
                    <p class="card-text">Keep track of your products and stock levels with ease.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="fa-solid fa-list fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Organize Categories</h5>
                    <p class="card-text">Categorize your products for better organization.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="fa-solid fa-cart-shopping fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Place Orders</h5>
                    <p class="card-text">Easily create and manage customer orders.</p>
                </div>
            </div>
        </div>
    </div>
</div>