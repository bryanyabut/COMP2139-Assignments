@{
    ViewBag.Title = "404 Page not found";
    Layout = "_Layout";
}

<div class="d-flex flex-column justify-content-center align-items-center vh-100 bg-light text-center">
    <h1 class="display-4 text-danger">404</h1>
    <h2 class="mb-4">Page Not Found</h2>
    <p class="mb-4">Sorry, the page you are looking for does not exist.</p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-house"></i> Go to Home
    </a>
</div>